{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Ivorovi Assessment Platform API",
    "description" : "All endpoints require an OIDC bearer token. Errors use application/problem+json with a stable `code` and a `traceId`.",
    "version" : "v1"
  },
  "security" : [ {
    "bearer" : [ ]
  } ],
  "paths" : {
    "/api/v1/features/{key}/override" : {
      "put" : {
        "tags" : [ "Features" ],
        "summary" : "Set a tenant-level (no institutionId) or institution-level override (requires feature.manage in scope)",
        "operationId" : "setOverride",
        "parameters" : [ {
          "name" : "key",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/OverrideRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/FeatureConfigurationView"
                }
              }
            }
          }
        }
      },
      "delete" : {
        "tags" : [ "Features" ],
        "summary" : "Remove an override so the value is inherited again",
        "operationId" : "clearOverride",
        "parameters" : [ {
          "name" : "key",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "institutionId",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/FeatureConfigurationView"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me" : {
      "get" : {
        "tags" : [ "Identity" ],
        "summary" : "Current user, tenant (with branding) and effective scoped permissions",
        "operationId" : "me",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/institutions" : {
      "get" : {
        "tags" : [ "Institutions" ],
        "summary" : "List institutions visible to the caller (search, sort, pagination)",
        "operationId" : "list",
        "parameters" : [ {
          "name" : "q",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          }
        }, {
          "name" : "page",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 0,
            "minimum" : 0
          }
        }, {
          "name" : "size",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 20
          }
        }, {
          "name" : "sort",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string",
            "default" : "name",
            "pattern" : "name|code|createdAt"
          }
        }, {
          "name" : "direction",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string",
            "default" : "asc",
            "pattern" : "asc|desc"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PageResponseInstitutionView"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/institutions/{id}" : {
      "get" : {
        "tags" : [ "Institutions" ],
        "summary" : "Get one institution",
        "operationId" : "get",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/InstitutionView"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/features" : {
      "get" : {
        "tags" : [ "Features" ],
        "summary" : "Effective features for the caller's tenant, optionally for one institution",
        "operationId" : "effective",
        "parameters" : [ {
          "name" : "institutionId",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/EffectiveFeature"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/features/configuration" : {
      "get" : {
        "tags" : [ "Features" ],
        "summary" : "Feature configuration with all layers (requires feature.read in scope)",
        "operationId" : "configuration",
        "parameters" : [ {
          "name" : "institutionId",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/FeatureConfigurationView"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/audit-events" : {
      "get" : {
        "tags" : [ "Audit" ],
        "summary" : "Search the tenant audit trail (newest first)",
        "operationId" : "search",
        "parameters" : [ {
          "name" : "action",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string",
            "pattern" : "[a-z0-9_.]{1,100}"
          }
        }, {
          "name" : "resourceType",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string",
            "pattern" : "[a-z0-9_.]{1,100}"
          }
        }, {
          "name" : "outcome",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string",
            "enum" : [ "SUCCESS", "DENIED", "FAILURE" ]
          }
        }, {
          "name" : "from",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string",
            "format" : "date-time"
          }
        }, {
          "name" : "to",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string",
            "format" : "date-time"
          }
        }, {
          "name" : "page",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 0,
            "minimum" : 0
          }
        }, {
          "name" : "size",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 25
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PageResponseAuditEvent"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/audit-events/verification" : {
      "get" : {
        "tags" : [ "Audit" ],
        "summary" : "Verify the integrity of the tenant's hash-chained audit trail",
        "operationId" : "verify",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuditVerification"
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "OverrideRequest" : {
        "type" : "object",
        "properties" : {
          "institutionId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "enabled" : {
            "type" : "boolean"
          }
        },
        "required" : [ "enabled" ]
      },
      "FeatureConfigurationView" : {
        "type" : "object",
        "properties" : {
          "key" : {
            "type" : "string"
          },
          "category" : {
            "type" : "string"
          },
          "description" : {
            "type" : "string"
          },
          "defaultEnabled" : {
            "type" : "boolean"
          },
          "institutionOverridable" : {
            "type" : "boolean"
          },
          "deploymentDisabled" : {
            "type" : "boolean"
          },
          "tenantOverride" : {
            "type" : "boolean"
          },
          "institutionOverride" : {
            "type" : "boolean"
          },
          "enabled" : {
            "type" : "boolean"
          },
          "source" : {
            "type" : "string"
          }
        }
      },
      "GrantView" : {
        "type" : "object",
        "properties" : {
          "permission" : {
            "type" : "string"
          },
          "role" : {
            "type" : "string"
          },
          "scopeType" : {
            "type" : "string"
          },
          "scopeId" : {
            "type" : "string",
            "format" : "uuid"
          }
        }
      },
      "MeResponse" : {
        "type" : "object",
        "properties" : {
          "userId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "email" : {
            "type" : "string"
          },
          "displayName" : {
            "type" : "string"
          },
          "tenant" : {
            "$ref" : "#/components/schemas/TenantView"
          },
          "roles" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "grants" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/GrantView"
            }
          }
        }
      },
      "TenantView" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "code" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "branding" : {
            "type" : "object",
            "additionalProperties" : { }
          }
        }
      },
      "InstitutionView" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "code" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "status" : {
            "type" : "string"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "PageResponseInstitutionView" : {
        "type" : "object",
        "properties" : {
          "items" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/InstitutionView"
            }
          },
          "page" : {
            "type" : "integer",
            "format" : "int32"
          },
          "size" : {
            "type" : "integer",
            "format" : "int32"
          },
          "totalElements" : {
            "type" : "integer",
            "format" : "int64"
          },
          "totalPages" : {
            "type" : "integer",
            "format" : "int32"
          }
        }
      },
      "EffectiveFeature" : {
        "type" : "object",
        "properties" : {
          "key" : {
            "type" : "string"
          },
          "category" : {
            "type" : "string"
          },
          "enabled" : {
            "type" : "boolean"
          },
          "source" : {
            "type" : "string"
          }
        }
      },
      "AuditEvent" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "seq" : {
            "type" : "integer",
            "format" : "int64"
          },
          "occurredAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "actorId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "actorSubject" : {
            "type" : "string"
          },
          "action" : {
            "type" : "string"
          },
          "resourceType" : {
            "type" : "string"
          },
          "resourceId" : {
            "type" : "string"
          },
          "outcome" : {
            "type" : "string",
            "enum" : [ "SUCCESS", "DENIED", "FAILURE" ]
          },
          "details" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "string"
            }
          },
          "clientIp" : {
            "type" : "string"
          },
          "traceId" : {
            "type" : "string"
          }
        }
      },
      "PageResponseAuditEvent" : {
        "type" : "object",
        "properties" : {
          "items" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/AuditEvent"
            }
          },
          "page" : {
            "type" : "integer",
            "format" : "int32"
          },
          "size" : {
            "type" : "integer",
            "format" : "int32"
          },
          "totalElements" : {
            "type" : "integer",
            "format" : "int64"
          },
          "totalPages" : {
            "type" : "integer",
            "format" : "int32"
          }
        }
      },
      "AuditVerification" : {
        "type" : "object",
        "properties" : {
          "valid" : {
            "type" : "boolean"
          },
          "eventsChecked" : {
            "type" : "integer",
            "format" : "int64"
          },
          "firstInvalidSeq" : {
            "type" : "integer",
            "format" : "int64"
          }
        }
      }
    },
    "securitySchemes" : {
      "bearer" : {
        "type" : "http",
        "scheme" : "bearer",
        "bearerFormat" : "JWT"
      }
    }
  }
}
