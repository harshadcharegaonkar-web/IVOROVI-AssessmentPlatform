  "components" : {
    "schemas" : {
      "TenantSettingsUpdateRequest" : {
        "type" : "object",
        "properties" : {
          "labels" : {
            "type" : "object",
            "additionalProperties" : {
              "$ref" : "#/components/schemas/UnitTypeLabel"
            }
          },
          "timeZone" : {
            "type" : "string",
            "maxLength" : 64,
            "minLength" : 0
          },
          "version" : {
            "type" : "integer",
            "format" : "int64"
          }
        },
        "required" : [ "version" ]
      },
      "UnitTypeLabel" : {
        "type" : "object",
        "properties" : {
          "singular" : {
            "type" : "string"
          },
          "plural" : {
            "type" : "string"
          }
        }
      },
      "TenantSettings" : {
        "type" : "object",
        "properties" : {
          "labels" : {
            "type" : "object",
            "additionalProperties" : {
              "$ref" : "#/components/schemas/UnitTypeLabel"
            }
          },
          "timeZone" : {
            "type" : "string"
          },
          "version" : {
            "type" : "integer",
            "format" : "int64"
          }
        }
      },
      "OverrideRequest" : {
        "type" : "object",
        "properties" : {
          "orgUnitId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "enabled" : {
            "type" : "boolean"
          }
        },
        "required" : [ "enabled" ]
      },
      "FeatureConfigurationView" : {
        "type" : "object",
        "properties" : {
          "key" : {
            "type" : "string"
          },
          "category" : {
            "type" : "string"
          },
          "description" : {
            "type" : "string"
          },
          "defaultEnabled" : {
            "type" : "boolean"
          },
          "institutionOverridable" : {
            "type" : "boolean"
          },
          "deploymentDisabled" : {
            "type" : "boolean"
          },
          "tenantOverride" : {
            "type" : "boolean"
          },
          "unitOverride" : {
            "type" : "boolean"
          },
          "inheritedEnabled" : {
            "type" : "boolean"
          },
          "inheritedSource" : {
            "type" : "string"
          },
          "enabled" : {
            "type" : "boolean"
          },
          "source" : {
            "type" : "string"
          }
        }
      },
      "OrgUnitCreateRequest" : {
        "type" : "object",
        "properties" : {
          "type" : {
            "type" : "string",
            "enum" : [ "UNIVERSITY", "COLLEGE", "CAMPUS", "DEPARTMENT" ]
          },
          "parentId" : {
            "type" : "string",
            "format" : "uuid"
          },
